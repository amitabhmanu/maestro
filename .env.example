# Copy to .env (git-ignored) on the machine that keeps the canon stores. Never commit the real file.
# One connection string per maestro: MAESTRO_DSN_<SLUG>, slug upper-cased with - as _.
# Prefer keeping the password in pgpass.conf (%APPDATA%\postgresql\pgpass.conf on Windows,
# ~/.pgpass elsewhere) and leaving it out of these strings.
MAESTRO_DSN_RAFI=postgresql://maestro@localhost:5432/maestro_rafi
MAESTRO_DSN_EDDY_ARNOLD=postgresql://maestro@localhost:5432/maestro_eddy_arnold
MAESTRO_DSN_JEAN_WIENER=postgresql://maestro@localhost:5432/maestro_jean_wiener

# Private data layer (raw pages, backups). Default: ./data inside the repo.
# MAESTRO_DATA_DIR=C:/Users/you/maestro-data
# Where maestro-backup writes. Default: <MAESTRO_DATA_DIR>/backups. A synced or external folder is better.
# MAESTRO_BACKUP_DIR=D:/maestro-backups
# PostgreSQL client programs, if not on PATH (found automatically under C:\Program Files\PostgreSQL).
# MAESTRO_PG_BIN=C:/Program Files/PostgreSQL/18/bin

# API tokens (optional). Discogs: a free personal token (discogs.com > Settings > Developers) raises the
# API rate from 25 to 60 requests a minute.
# DISCOGS_TOKEN=
# Last.fm: a free API key (last.fm/api) for listener counts per track (popularity, rare gems).
# LASTFM_API_KEY=
