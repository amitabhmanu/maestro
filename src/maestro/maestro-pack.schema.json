{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amitabhmanu/maestro/schemas/maestro-pack.schema.json",
  "title": "Maestro pack",
  "description": "Everything maestro-specific the harness needs. The core reads only this file; it never hard-codes anything about a particular maestro.",
  "type": "object",
  "required": ["version", "status", "identity", "roles", "canon_model", "tiers", "sources", "verification", "legal", "budget"],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "description": "Why the profiler proposed a value. Optional on every object.",
      "type": "object",
      "properties": {
        "reason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "role": {"enum": ["singer", "composer", "lyricist", "instrumentalist", "arranger", "producer", "music_director", "actor", "conductor"]},
    "unit": {"enum": ["song", "recording", "work", "cue", "lyric"]},
    "container": {"enum": ["film", "album", "session", "score", "work_catalogue", "broadcast", "none"]},
    "access": {"enum": ["api", "crawlable", "print_owned", "print_library", "print", "licensed", "unavailable"]}
  },
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "status": {
      "description": "draft = proposed by the profiler; approved = signed off by the user.",
      "enum": ["draft", "approved"]
    },
    "identity": {
      "type": "object",
      "required": ["name", "slug", "ids", "active"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "ids": {
          "type": "object",
          "description": "Stable external IDs. Use null for an ID not yet confirmed.",
          "properties": {
            "wikidata": {"type": ["string", "null"], "pattern": "^Q[0-9]+$"},
            "musicbrainz": {"type": ["string", "null"]},
            "viaf": {"type": ["string", "null"]},
            "isni": {"type": ["string", "null"]},
            "bnf": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "variants": {"type": "array", "items": {"type": "string"}},
        "namesakes": {"type": "array", "items": {"type": "string"}},
        "active": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1800, "maximum": 2100},
          "minItems": 2,
          "maxItems": 2
        },
        "_why": {"$ref": "#/$defs/evidence"}
      }
    },
    "roles": {
      "type": "object",
      "required": ["primary", "in_scope"],
      "additionalProperties": false,
      "properties": {
        "primary": {"$ref": "#/$defs/role"},
        "in_scope": {"type": "array", "items": {"$ref": "#/$defs/role"}, "minItems": 1},
        "out_of_scope": {"type": "array", "items": {"$ref": "#/$defs/role"}},
        "_why": {"$ref": "#/$defs/evidence"}
      }
    },
    "canon_model": {
      "type": "object",
      "required": ["unit", "container", "container_has_full_listing"],
      "additionalProperties": false,
      "properties": {
        "unit": {"$ref": "#/$defs/unit"},
        "version_levels": {"type": "array", "items": {"enum": ["work", "recording", "release"]}},
        "container": {"$ref": "#/$defs/container"},
        "kind_tiers": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Tier for a unit with no tier of its own, by the kind of work a source says it is (`work_kind` claim), e.g. {film_score: B}."},
        "match_titles_across_containers": {"type": "boolean", "description": "Match a unit that no container holds (e.g. a release database's recording) to the one contained unit of the same title anywhere in the canon. Default false."},
        "container_has_full_listing": {
          "type": "boolean",
          "description": "True when a container's full listing can be fetched, which enables container-as-unit completeness checks."
        },
        "_why": {"$ref": "#/$defs/evidence"}
      }
    },
    "tiers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z]$"},
      "additionalProperties": {
        "type": "object",
        "required": ["label", "target_missing"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string"},
          "target_missing": {
            "description": "Stop when the estimated missing share falls below this, e.g. 0.01. report_only = measure but never stop on it.",
            "oneOf": [{"type": "number", "exclusiveMinimum": 0, "maximum": 1}, {"const": "report_only"}]
          },
          "_why": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "tiers", "access", "role"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "tiers": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]$"}},
          "access": {"$ref": "#/$defs/access"},
          "role": {"enum": ["ground_truth", "independent_check", "partial"]},
          "url": {"type": "string"},
          "_why": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "lineage", "reliability", "access"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "kind": {"enum": ["structured", "semi", "prose"]},
          "lineage": {"type": "string", "description": "Sources that copy each other share a lineage; capture-recapture groups by it."},
          "reliability": {"type": "number", "minimum": 0, "maximum": 1},
          "access": {"$ref": "#/$defs/access"},
          "distinct_ids": {"type": "boolean", "description": "false when two of the source's ids can name one unit (MusicBrainz keeps a recording per release version); the resolver may then merge them. Default true."},
          "default_tier": {"type": "string", "description": "Tier for a unit known only from this source, with no tier of its own or from its container (e.g. A for a release database that lists issued recordings)."},
          "live_tier": {"type": "string", "description": "With default_tier: the tier for such a unit when the source marks it live."},
          "api_rps": {"type": "number", "exclusiveMinimum": 0, "description": "For access: api, the API's request limit per second. The fetcher skips robots.txt for an API host and keeps to this rate."},
          "url": {"type": "string"},
          "extractor": {"type": "string"},
          "sweep": {"type": "object", "required": ["url"], "additionalProperties": false, "description": "Listing pages the orchestrator may fetch unaided: url is a template over {year} (with years) or {page} and {offset} (with pages and page_size).", "properties": {"url": {"type": "string"}, "years": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}, "pages": {"type": "integer", "minimum": 1}, "page_size": {"type": "integer", "minimum": 1}, "extractor": {"type": "string"}, "purpose": {"enum": ["spine", "container_sweep", "enrich", "gap"]}}},
          "container_url": {"type": "string", "description": "Template for one container's page in this source, over {xref} (the container's id here) or {xref_q} (URL-quoted). The orchestrator refetches containers whose stored units fall short of this source's count."},
          "publishable": {"type": "boolean", "description": "Whether facts taken from this source may be included in a public release.", "default": true},
          "_why": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "lexicon": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Paths, relative to the pack folder, of alias and transliteration tables."
    },
    "collaborators": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "verification": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": {"enum": ["voice", "credit", "score_style", "none"]},
        "references": {"type": "string"},
        "confusables": {"type": "array", "items": {"type": "string"}},
        "_why": {"$ref": "#/$defs/evidence"}
      }
    },
    "checksums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "total", "source"],
        "additionalProperties": false,
        "properties": {
          "scope": {"type": "string"},
          "total": {"type": "integer", "minimum": 0},
          "breakdown": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "source": {"type": "string"},
          "filter": {
            "description": "Which canon units the published total counts, so the completeness engine can check it. Without a filter the checksum is reported but not checked.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tiers": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]$"}, "minItems": 1},
              "years": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2, "description": "Inclusive range; a unit's own year, else its container's."},
              "collaborator": {
                "type": "object", "required": ["role", "name"], "additionalProperties": false,
                "properties": {"role": {"type": "string"}, "name": {"type": "string"}}
              },
              "contained": {"type": "boolean", "description": "true: only units that belong to a container; false: only units that do not."}
            }
          },
          "breakdown_by": {
            "description": "How to split the observed count to compare with `breakdown`: by the number of people credited in `role`. Each bucket is [min, max]; max null means no upper bound.",
            "type": "object", "required": ["role", "buckets"], "additionalProperties": false,
            "properties": {
              "role": {"type": "string"},
              "buckets": {"type": "object", "additionalProperties": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "prefixItems": [{"type": "integer", "minimum": 0}, {"type": ["integer", "null"]}]}}
            }
          },
          "tolerance": {"type": "number", "minimum": 0, "maximum": 1, "description": "Relative difference still counted as a match (default 0.02)."}
        }
      }
    },
    "taxonomies": {"type": "object", "additionalProperties": {"type": "string"}},
    "popularity_signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contemporary": {"type": "array", "items": {"type": "string"}},
        "enduring": {"type": "array", "items": {"type": "string"}},
        "penetration": {"type": "array", "items": {"type": "string"}},
        "esteem": {"type": "array", "items": {"type": "string"}},
        "weights": {"type": "object", "additionalProperties": false,
                    "description": "Facet weights for the popularity score (defaults 0.35, 0.3, 0.2, 0.15).",
                    "properties": {
                      "contemporary": {"type": "number", "minimum": 0},
                      "enduring": {"type": "number", "minimum": 0},
                      "penetration": {"type": "number", "minimum": 0},
                      "esteem": {"type": "number", "minimum": 0}}}
      }
    },
    "legal": {
      "type": "object",
      "required": ["purpose", "lyrics", "audio"],
      "additionalProperties": false,
      "properties": {
        "purpose": {"enum": ["personal", "personal_then_foss", "public"]},
        "lyrics": {"enum": ["none", "first_line_only", "private_full"]},
        "lyric_fields": {
          "type": "array", "items": {"type": "string"}, "uniqueItems": true,
          "description": "Claim fields whose values quote lyrics (Hindi film song titles are the opening words), also keys inside dict values such as popularity mentions. lyrics and lyric always count."
        },
        "first_line_max": {"type": "integer", "minimum": 20, "maximum": 200, "description": "Longest publishable first line, in characters (default 80)."},
        "audio": {"enum": ["none", "derived_features_only"]},
        "_why": {"$ref": "#/$defs/evidence"}
      }
    },
    "budget": {
      "type": "object",
      "required": ["crawl_requests_per_round", "per_domain_rps"],
      "additionalProperties": false,
      "properties": {
        "crawl_requests_per_round": {"type": "integer", "minimum": 1},
        "per_domain_rps": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "model_spend_usd": {"type": ["number", "null"]},
        "review_hours_per_week": {"type": ["number", "null"]}
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
